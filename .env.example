# Kibana URL reachable from the Compose host.
KIBANA_URL=https://kibana.example.org
# Set either a Kibana API key or both username and password.
KIBANA_API_KEY=
KIBANA_USERNAME=
KIBANA_PASSWORD=

# Must be reachable from the Kibana container. Use the server's IP/hostname
# and the published agent port when Kibana is on a different Docker network.
AGENT_WEBHOOK_URL=http://your-server-hostname:8000/webhook/kibana
AGENT_PORT=8000
# Generate a long random value and use the same value for both services.
AGENT_WEBHOOK_TOKEN=

# The agent queries this Elasticsearch endpoint; auth settings are optional.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
RISK_SCORE_THRESHOLD=70
